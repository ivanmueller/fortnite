<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds against the FortniteReplayReader NuGet package (Shiqan/FortniteReplayDecompressor). -->
  <!-- If NuGet lags behind a new Fortnite season, setup builds source/fn-extract.source.csproj -->
  <!-- against the latest GitHub source instead (automatically, or with setup.ps1 -FromSource). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZoneLab.ReplayReader</AssemblyName>
    <!-- The parser only scans assemblies whose name contains "ReplayReader" (needed for the bus capture). -->
    <OutputPath>bin/nuget/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="vendor/**;source/**" />
    <PackageReference Include="FortniteReplayReader" Version="*" />
  </ItemGroup>
</Project>
