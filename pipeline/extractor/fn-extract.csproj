<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds against the FortniteReplayReader NuGet package (Shiqan/FortniteReplayDecompressor). -->
  <!-- If NuGet lags behind a new Fortnite season, run setup with -FromSource / --from-source, -->
  <!-- which builds source/fn-extract.source.csproj against the latest GitHub source instead.  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fn-extract</AssemblyName>
    <OutputPath>bin/nuget/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="vendor/**;source/**" />
    <PackageReference Include="FortniteReplayReader" Version="*" />
  </ItemGroup>
</Project>
