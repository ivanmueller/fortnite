<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same program as ../fn-extract.csproj, built against the latest GitHub source of -->
  <!-- Shiqan/FortniteReplayDecompressor (cloned into ../vendor by setup -FromSource). -->
  <!-- Use this when the NuGet package lags behind a new Fortnite season.             -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZoneLab.ReplayReader</AssemblyName>
    <!-- The parser only scans assemblies whose name contains "ReplayReader" (needed for the bus capture). -->
    <OutputPath>../bin/source/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../*.cs" />
    <ProjectReference Include="../vendor/FortniteReplayDecompressor/src/FortniteReplayReader/FortniteReplayReader.csproj" />
  </ItemGroup>
</Project>
